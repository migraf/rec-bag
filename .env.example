# Local development only. Keep real credentials in the ignored .env file.
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
SOUNDCLOUD_KEY=your-soundcloud-client-secret
# Comma-separated exact callback URI allow-list; no wildcards. The first loopback http entry is
# served to the desktop app as its redirect and must also be registered in the SoundCloud app.
SOUNDCLOUD_ALLOWED_REDIRECT_URIS=http://127.0.0.1:17841/oauth/soundcloud

# Google Drive (desktop). Debug desktop builds load .env; REC_BAG_LOAD_DOTENV overrides.
# Use a "Desktop app" OAuth client: no redirect URI registration is needed, and its secret is
# not confidential in an installed app but is required by Google's token endpoint.
REC_BAG_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
REC_BAG_GOOGLE_CLIENT_SECRET=your-desktop-client-secret
# Optional; any loopback port works for Desktop-type clients.
# REC_BAG_GOOGLE_REDIRECT_URI=http://127.0.0.1:17842/oauth/google
